{
  "name": "fractalbot",
  "version": "1.1.0",
  "description": "Fractal 6b Slave Bot — Mineflayer control for 6b6t with captcha alerts, dual-portal lobby, and Elytra terrain mapping (Xaero regions)",
  "type": "module",
  "bin": {
    "fractalbot": "./bin/fractalbot.mjs"
  },
  "main": "./src/api/index.ts",
  "exports": {
    ".": "./src/api/index.ts",
    "./api": "./src/api/index.ts",
    "./config": "./src/config.ts",
    "./logger": "./src/logger.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "npx tsx src/index.ts",
    "fractalbot": "npx tsx src/index.ts",
    "dev": "npx tsx src/index.ts shell",
    "test": "npx tsx --test src/minecraft/lobby/portals.test.ts src/minecraft/lobby/navigator.test.ts \"src/hunt/*.test.ts\" \"src/settings/*.test.ts\" \"src/kitbot/*.test.ts\"",
    "typecheck": "npx tsc -p tsconfig.json --noEmit",
    "build": "npx tsc -p tsconfig.json --noEmit",
    "lint": "npx tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mineflayer",
    "minecraft",
    "6b6t",
    "bot"
  ],
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.0",
    "dotenv": "^17.2.1",
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.5",
    "vec3": "^0.1.10",
    "ws": "^8.18.3"
  },
  "optionalDependencies": {
    "discord.js": "^14.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
